# Copy this file to .env and fill in real values. NEVER commit .env.
# The project works with no keys at all for search (EMBEDDING_PROVIDER=hashing).
# Answer generation (POST /ask) needs an LLM key.

# --- Answer generation (LLM) ---
LLM_PROVIDER=openrouter
# Exact model ID from the OpenRouter model page, e.g. qwen/<model-name>
LLM_MODEL=your_qwen_model_id
OPENROUTER_API_KEY=your_key_here
OPENAI_API_KEY=

# --- Embeddings ---
# hashing    = local, offline, lexical (default; no key, no network)
# openrouter = semantic embeddings via OpenRouter, e.g. EMBEDDING_MODEL=qwen/qwen3-embedding-0.6b
# openai     = semantic embeddings via OpenAI
EMBEDDING_PROVIDER=hashing
EMBEDDING_MODEL=
# Optional override for any other OpenAI-compatible embeddings server.
EMBEDDING_BASE_URL=

# --- Retrieval ---
TOP_K=4
# Minimum similarity for a passage to count as relevant. Leave empty to use the
# embedder's default; tune it with: python -m scripts.evaluate
MIN_SCORE=

# --- Paths ---
DOCS_DIR=docs
INDEX_DIR=data/index
# Index everything in DOCS_DIR on startup.
AUTO_INGEST=true
